{
  "name": "Markdown-Converter",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "onCreateCommand": "sudo apt-get update && sudo apt-get install -y tesseract-ocr tesseract-ocr-nor tesseract-ocr-eng poppler-utils",
  "postCreateCommand": "python -m venv .venv && .venv/bin/pip install --upgrade pip && .venv/bin/pip install -e \".[dev]\"",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Markdown-Converter",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
      }
    }
  }
}
